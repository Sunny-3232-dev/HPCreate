---
import Base from './Base.astro';
interface Props { title: string; updated: string }
const { title, updated } = Astro.props;
---
<Base title={title}>
  <article class="legal container">
    <a class="back" href="/">← トップに戻る</a>
    <h1>{title}</h1>
    <slot />
    <p class="updated">最終更新：{updated}</p>
  </article>
</Base>

<style>
  .legal { max-width: 860px; padding-block: 64px 120px; }
  .back { font-size: 0.9rem; font-weight: 700; color: var(--forest); text-decoration: none; }
  h1 { font-weight: 900; font-size: clamp(1.6rem, 4vw, 2.3rem); margin: 20px 0 32px; }
  .legal :global(h2) { font-weight: 900; font-size: 1.15rem; margin: 40px 0 12px; }
  .legal :global(p), .legal :global(li) { color: var(--ink-2); font-size: 0.98rem; }
  .legal :global(ul) { padding-left: 1.4em; margin-top: 8px; }
  .legal :global(table) { width: 100%; border-collapse: collapse; margin-top: 16px; }
  .legal :global(th), .legal :global(td) { text-align: left; vertical-align: top; padding: 16px 12px; border-bottom: 1px solid var(--line); font-size: 0.92rem; }
  .legal :global(th) { width: 30%; font-weight: 700; white-space: nowrap; }
  .updated { margin-top: 48px; font-size: 0.85rem; color: var(--ink-3); }
  @media (max-width: 640px) {
    .legal :global(th), .legal :global(td) { display: block; width: 100%; }
    .legal :global(th) { border-bottom: 0; padding-bottom: 0; }
  }
</style>
