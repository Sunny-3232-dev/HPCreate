---
const steps = [
  { t: '話を聞かせてください', d: '電話かフォームで。いまの状況と気になっていることを伺います。30分ほど。', when: '1日目' },
  { t: 'お店用のサンプルをお見せします', d: '口コミを読んだうえでトップページの見本を作ります。ここまで無料。', when: '〜1週間' },
  { t: 'お店に伺い、撮影と聞き取り', d: 'ご契約後に写真を撮りに伺います。原稿はこちらで書きます。', when: '2週目' },
  { t: '仕上げて、確認していただく', d: '写真とお話が揃ってから10営業日ほど。直しは2回まで。', when: '2〜3週目' },
  { t: '公開と、Googleマップの設定', d: 'ホームページを公開し、Googleマップにもリンクを。口コミ用のQRカードもお渡しします。', when: '3週目' },
];
---
<section id="flow" class="section flow">
  <div class="container">
    <p class="label">進め方</p>
    <h2 class="h2" data-split>ご相談から公開まで、<br />だいたい3週間です。</h2>
    <p class="lead">パソコンが苦手でも大丈夫です。わからない言葉が出てきたら、その場で聞いてください。</p>
    <ol class="route">
      <span class="road" aria-hidden="true"></span>
      {steps.map((s, i) => (
        <li class="reveal">
          <span class="stop" aria-hidden="true">{i + 1}</span>
          <p class="when">{s.when}</p>
          <h3>{s.t}</h3>
          <p>{s.d}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .flow { background: var(--paper); }
  .route { list-style: none; position: relative; display: grid; grid-template-columns: repeat(5, 1fr); gap: 20px; margin-top: 56px; padding-top: 12px; }
  /* 道が、スクロールに合わせて伸びる（CSS Scroll-driven Animations） */
  .road { position: absolute; left: 20px; right: 20px; top: 31px; height: 6px; border-radius: 6px; background: var(--stone-2); overflow: hidden; }
  .road::after { content: ''; position: absolute; inset: 0; background: repeating-linear-gradient(90deg, var(--star) 0 18px, transparent 18px 28px); transform-origin: left; }
  @supports (animation-timeline: view()) {
    .road::after { animation: grow linear both; animation-timeline: view(); animation-range: entry 20% cover 55%; }
  }
  @keyframes grow { from { transform: scaleX(0); } }
  li { position: relative; }
  .stop { position: relative; display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; background: var(--forest); color: #fff; font-weight: 900; border: 4px solid var(--paper); }
  .when { margin-top: 14px; font-size: 0.8rem; font-weight: 900; color: var(--forest-2); }
  h3 { font-weight: 900; font-size: 1.1rem; line-height: 1.45; margin-top: 4px; }
  li p:last-child { font-size: 0.92rem; color: var(--ink-2); margin-top: 6px; }
  @media (max-width: 960px) {
    .route { grid-template-columns: 1fr; gap: 28px; padding-left: 64px; }
    .road { left: 19px; right: auto; top: 20px; bottom: 20px; width: 6px; height: auto; }
    .road::after { background: repeating-linear-gradient(180deg, var(--star) 0 18px, transparent 18px 28px); transform-origin: top; }
    @supports (animation-timeline: view()) { .road::after { animation-name: grow-y; } }
    .stop { position: absolute; left: -64px; top: 0; }
    .when { margin-top: 0; }
  }
  @keyframes grow-y { from { transform: scaleY(0); } }
</style>
