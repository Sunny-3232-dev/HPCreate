---
const steps = [
  { t: 'まず、話を聞かせてください', d: '電話かフォームで。いまの状況と、気になっていることを伺います。30分ほどです。' },
  { t: 'お店用のサンプルをお見せします', d: '口コミを読んだうえで、トップページのサンプルを作ってお持ちします。ここまでは無料です。' },
  { t: 'お店に伺って、撮影と聞き取り', d: 'ご契約いただいたら、写真を撮りに伺います。原稿はこちらで書きます。' },
  { t: '仕上げて、確認していただく', d: '写真とお話が揃ってから、10営業日ほどで仕上げます。直しは2回まで承ります。' },
  { t: '公開と、Googleマップの設定', d: 'ホームページを公開し、Googleマップの登録情報にもリンクを入れます。口コミをお願いするときに使えるQRカードもお渡しします。' },
];
---
<section id="flow" class="section flow">
  <div class="container grid">
    <div class="head">
      <p class="eyebrow">進め方</p>
      <h2 class="h-sec" data-split>ご相談から公開まで、<br />だいたい3週間です。</h2>
      <p class="lead">パソコンが苦手でも大丈夫です。わからない言葉が出てきたら、その場で聞いてください。</p>
    </div>
    <ol class="timeline">
      <span class="line" aria-hidden="true"></span>
      {steps.map((s, i) => (
        <li class="reveal">
          <span class="dot" aria-hidden="true">{i + 1}</span>
          <h3>{s.t}</h3>
          <p>{s.d}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .flow { background: var(--bg-soft); }
  .grid { display: grid; grid-template-columns: 1fr 1.2fr; gap: clamp(32px, 6vw, 96px); }
  .head { position: sticky; top: 120px; align-self: start; }
  .timeline { list-style: none; position: relative; display: grid; gap: 40px; padding-left: 56px; }
  .line { position: absolute; left: 17px; top: 8px; bottom: 8px; width: 2px; background: var(--hairline); overflow: hidden; }
  .line::after { content: ''; position: absolute; inset: 0; background: var(--amber); transform-origin: top; transform: scaleY(1); }
  /* スクロールに合わせて線が伸びる（CSS Scroll-driven Animations） */
  @supports (animation-timeline: view()) {
    .timeline { view-timeline: --flow block; }
    .line::after { animation: grow-y linear both; animation-timeline: --flow; animation-range: cover 10% cover 70%; }
  }
  @keyframes grow-y { from { transform: scaleY(0); } }
  li { position: relative; }
  .dot {
    position: absolute; left: -56px; top: 2px; width: 36px; height: 36px; border-radius: 50%;
    display: grid; place-items: center; background: var(--paper); border: 2px solid var(--amber);
    font-weight: 700; font-size: 0.9rem; color: var(--amber-deep);
  }
  h3 { font-family: var(--font-serif); font-size: 1.2rem; line-height: 1.6; padding-top: 4px; }
  p { color: var(--ink-soft); font-size: 0.93rem; margin-top: 6px; }
  @media (max-width: 860px) { .grid { grid-template-columns: 1fr; } .head { position: static; } }
</style>
