---
import { site } from '../data/site';
import Logo from './Logo.astro';
const nav = [
  { href: '/#why', label: 'なぜ必要か' },
  { href: '/#samples', label: 'サンプル' },
  { href: '/#plans', label: '料金' },
  { href: '/#flow', label: '進め方' },
  { href: '/#faq', label: 'ご質問' },
];
const tel = site.tel.replace(/-/g, '');
---
<header class="site-header">
  <div class="container bar">
    <a class="brand" href="/" aria-label={`${site.name} トップへ`}>
      <Logo size={30} />
      <span class="name">{site.name}<small>宇都宮のホームページ制作</small></span>
    </a>
    <nav class="nav" aria-label="メイン">
      {nav.map((n) => <a href={n.href}>{n.label}</a>)}
    </nav>
    {site.tel && (
      <a class="tel" href={`tel:${tel}`}>
        <span class="tel-label">お電話</span>
        <span class="tel-num">{site.tel}</span>
      </a>
    )}
    <button class="menu-btn" type="button" popovertarget="mobile-menu" aria-label="メニューを開く">
      <span></span><span></span><span></span>
    </button>
  </div>
  <div id="mobile-menu" class="mobile-menu" popover>
    <nav aria-label="モバイル">
      {nav.map((n) => <a href={n.href}>{n.label}</a>)}
    </nav>
    <div class="mm-cta">
      {site.tel && <a class="btn btn--star" href={`tel:${tel}`}>電話する {site.tel}</a>}
      <a class="btn btn--line" href="/#contact">フォームで相談する</a>
    </div>
  </div>
</header>

<script>
  const menu = document.getElementById('mobile-menu');
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => menu.hidePopover()));
</script>

<style>
  .site-header { position: sticky; top: 0; z-index: 50; transition: transform 0.4s var(--ease-out), background 0.3s, box-shadow 0.3s; }
  .site-header:global(.is-scrolled) {
    background: color-mix(in oklab, var(--stone) 88%, transparent);
    backdrop-filter: blur(14px) saturate(1.3);
    box-shadow: 0 1px 0 var(--line);
  }
  .site-header:global(.is-hidden) { transform: translateY(-100%); }
  .bar { display: flex; align-items: center; gap: 28px; height: 76px; }
  .brand { display: flex; align-items: center; gap: 10px; text-decoration: none; margin-right: auto; }
  .name { font-weight: 900; font-size: 1.2rem; line-height: 1.1; letter-spacing: 0.02em; }
  .name small { display: block; font-size: 0.62rem; font-weight: 700; color: var(--ink-3); letter-spacing: 0.08em; margin-top: 3px; }
  .nav { display: flex; gap: 26px; }
  .nav a { font-size: 0.92rem; font-weight: 700; text-decoration: none; padding-block: 6px; background: linear-gradient(var(--star), var(--star)) left bottom / 0 3px no-repeat; transition: background-size 0.3s var(--ease-out); }
  .nav a:hover { background-size: 100% 3px; }
  .tel { display: grid; text-decoration: none; line-height: 1.15; padding: 8px 16px; border-radius: 12px; background: var(--forest); color: #fff; }
  .tel-label { font-size: 0.66rem; font-weight: 700; opacity: 0.8; }
  .tel-num { font-size: 1.05rem; font-weight: 900; letter-spacing: 0.03em; }
  .menu-btn { display: none; width: 48px; height: 48px; border: 0; border-radius: 12px; background: var(--forest); cursor: pointer; position: relative; }
  .menu-btn span { position: absolute; left: 13px; right: 13px; height: 2px; background: #fff; border-radius: 2px; }
  .menu-btn span:nth-child(1) { top: 16px; }
  .menu-btn span:nth-child(2) { top: 23px; }
  .menu-btn span:nth-child(3) { top: 30px; }

  .mobile-menu {
    inset: 0; width: 100%; height: 100dvh; max-width: none; max-height: none; border: 0;
    background: var(--forest); color: #fff; padding: 100px var(--gutter) 32px;
    display: none; flex-direction: column; justify-content: space-between;
    opacity: 0; transform: translateY(-12px);
    transition: opacity 0.35s var(--ease-out), transform 0.35s var(--ease-out), display 0.35s allow-discrete, overlay 0.35s allow-discrete;
  }
  .mobile-menu:popover-open { display: flex; opacity: 1; transform: none; }
  @starting-style { .mobile-menu:popover-open { opacity: 0; transform: translateY(-12px); } }
  .mobile-menu nav { display: grid; }
  .mobile-menu nav a { font-size: 1.6rem; font-weight: 900; text-decoration: none; padding: 14px 0; border-bottom: 1px solid rgba(255, 255, 255, 0.15); }
  .mm-cta { display: grid; gap: 12px; }

  @media (max-width: 1000px) {
    .nav { display: none; }
  }
  @media (max-width: 640px) {
    .tel { display: none; }
    .menu-btn { display: block; z-index: 60; }
    .bar { height: 68px; }
  }
</style>
