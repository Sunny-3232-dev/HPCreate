---
import { plans, yen } from '../data/site';
const main = plans.find((p) => 'featured' in p && p.featured)!;
const others = plans.filter((p) => p !== main);
---
<section id="plans" class="section plans">
  <div class="container">
    <p class="label">料金</p>
    <h2 class="h2" data-split>料金は、先に<br />ぜんぶ書いておきます。</h2>
    <p class="lead">表示はすべて税抜です。制作費は、着手時と公開時の2回に分けてお支払いいただけます。</p>

    <article class="main reveal">
      <div class="price-col">
        <p class="badge">はじめての方に</p>
        <h3>{main.name}</h3>
        <p class="price"><span class="yen">¥</span><span data-count={main.price}>{main.price.toLocaleString('ja-JP')}</span></p>
        <p class="monthly">公開後の保守は 月{yen(main.monthly)}〜（なくても可）</p>
        <p class="summary">{main.summary}</p>
        <a class="btn btn--star" href="#contact">このプランで相談する<span class="arrow" aria-hidden="true">→</span></a>
      </div>
      <ul class="includes">
        {main.features.map((f) => <li>{f}</li>)}
      </ul>
    </article>

    <h3 class="sub reveal">ほかのプラン</h3>
    <div class="table reveal" role="table" aria-label="ほかのプラン">
      {others.map((p) => (
        <div class="row" role="row">
          <div class="name" role="cell">
            <b>{p.name}</b>
            <span>{p.summary}</span>
          </div>
          <div class="feat" role="cell">{p.features.join('／')}</div>
          <div class="cost" role="cell">
            <b>{yen(p.price)}{'from' in p && p.from ? '〜' : ''}</b>
            <span>保守 月{yen(p.monthly)}〜</span>
          </div>
        </div>
      ))}
    </div>
    <p class="note">予約システムやネットショップが必要な場合は、内容を伺ってからお見積りします。</p>
  </div>
</section>

<style>
  .plans { background: var(--stone); }
  .main {
    display: grid; grid-template-columns: 1fr 1fr; gap: 0; margin-top: 48px;
    border-radius: 28px; overflow: hidden; background: var(--paper); border: 2px solid var(--forest);
  }
  .price-col { background: var(--forest); color: #fff; padding: clamp(28px, 4vw, 48px); display: flex; flex-direction: column; align-items: flex-start; }
  .badge { font-size: 0.8rem; font-weight: 900; background: var(--star); color: var(--ink); border-radius: 6px; padding: 2px 10px; }
  .price-col h3 { font-weight: 900; font-size: 1.5rem; margin-top: 14px; }
  .price { font-weight: 900; font-size: clamp(3rem, 7vw, 4.6rem); line-height: 1.05; margin-top: 8px; letter-spacing: -0.01em; }
  .yen { font-size: 0.5em; margin-right: 4px; vertical-align: 0.35em; }
  .monthly { color: var(--forest-ink); font-size: 0.95rem; margin-top: 6px; }
  .summary { margin-top: 16px; }
  .price-col .btn { margin-top: auto; }
  .price-col .summary { margin-bottom: 28px; }
  .includes { list-style: none; padding: clamp(28px, 4vw, 48px); display: grid; gap: 14px; align-content: center; }
  .includes li { position: relative; padding-left: 36px; font-weight: 700; }
  .includes li::before {
    content: '✓'; position: absolute; left: 0; top: 0.15em; width: 24px; height: 24px; border-radius: 50%;
    display: grid; place-items: center; background: var(--star-soft); color: var(--forest); font-size: 0.8rem; font-weight: 900;
  }
  .sub { font-weight: 900; font-size: 1.2rem; margin-top: 56px; }
  .table { margin-top: 12px; border-top: 2px solid var(--ink); }
  .row { display: grid; grid-template-columns: 1.3fr 1.5fr 0.8fr; gap: 24px; padding: 20px 4px; border-bottom: 1px solid var(--line); align-items: center; }
  .name b { display: block; font-weight: 900; font-size: 1.1rem; }
  .name span, .feat { font-size: 0.9rem; color: var(--ink-2); }
  .cost { text-align: right; }
  .cost b { display: block; font-weight: 900; font-size: 1.3rem; }
  .cost span { font-size: 0.82rem; color: var(--ink-3); }
  .note { margin-top: 20px; font-size: 0.9rem; color: var(--ink-3); }
  @media (max-width: 860px) {
    .main { grid-template-columns: 1fr; }
    .row { grid-template-columns: 1fr; gap: 6px; }
    .cost { text-align: left; }
  }
</style>
