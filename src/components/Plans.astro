---
import { plans, yen } from '../data/site';
---
<section id="plans" class="section plans">
  <div class="container">
    <p class="eyebrow">料金</p>
    <h2 class="h-sec" data-split>料金は、先に<br />ぜんぶ書いておきます。</h2>
    <p class="lead">表示はすべて税抜です。制作費は、着手時と公開時の2回に分けてお支払いいただけます。月々の保守は、なくても構いません。</p>
    <div class="grid">
      {plans.map((p) => {
        const featured = 'featured' in p && p.featured;
        return (
          <article class:list={['plan', 'reveal', { featured }]}>
            {featured && <p class="badge">はじめての方におすすめ</p>}
            <h3>{p.name}</h3>
            <p class="price">
              {yen(p.price)}
              {'from' in p && p.from && <small>〜</small>}
            </p>
            <p class="monthly">保守 月{yen(p.monthly)}〜（任意）</p>
            <p class="summary">{p.summary}</p>
            <ul>
              {p.features.map((f) => <li>{f}</li>)}
            </ul>
            <a class:list={['btn', { 'btn--ghost': !featured }]} href="#contact">このプランについて聞く</a>
          </article>
        );
      })}
    </div>
    <p class="note">予約システムやネットショップが必要な場合は、内容を伺ってからお見積りします。</p>
  </div>
</section>

<style>
  .grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-top: 48px; align-items: stretch; }
  .plan { position: relative; display: flex; flex-direction: column; padding: 32px 24px; border-radius: 12px; background: var(--paper); border: 1px solid var(--hairline); }
  .featured { border: 2px solid var(--amber-deep); background: #fff; }
  .badge { position: absolute; top: -12px; left: 20px; background: var(--amber-deep); color: #fff; font-size: 0.75rem; font-weight: 700; padding: 2px 12px; border-radius: 4px; }
  h3 { font-family: var(--font-serif); font-size: 1.2rem; }
  .price { font-size: 2rem; font-weight: 700; margin-top: 12px; line-height: 1.2; }
  .price small { font-size: 0.55em; }
  .monthly { font-size: 0.82rem; margin-top: 6px; color: var(--ink-muted); }
  .summary { font-size: 0.9rem; margin-top: 16px; color: var(--ink-soft); }
  ul { list-style: none; margin: 16px 0 28px; display: grid; gap: 6px; font-size: 0.86rem; }
  li { padding-left: 1.3em; position: relative; }
  li::before { content: '・'; position: absolute; left: 0; color: var(--amber-deep); }
  .plan .btn { margin-top: auto; justify-content: center; font-size: 0.85rem; padding: 12px 18px; }
  .note { margin-top: 24px; font-size: 0.88rem; color: var(--ink-muted); }
  @media (max-width: 1100px) { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 640px) { .grid { grid-template-columns: 1fr; } }
</style>
