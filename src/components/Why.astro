---
// 「なぜHPが必要か」：市場データ ＋ Google検索の Before/After（スクロールで切り替え）
const steps = [
  {
    t: '口コミは良いのに、情報が足りない',
    d: 'Googleマップには★と口コミが並んでいる。でも「メニューは？」「料金は？」「どんな人がやっているの？」——判断材料がないと、お客様は隣のお店を開きます。',
  },
  {
    t: '「ウェブサイト」ボタンが加わる',
    d: 'ホームページとGoogleビジネスプロフィールを整えると、検索結果に写真・営業時間・サイトへのリンクが揃います。お店の「顔」がはっきりします。',
  },
  {
    t: '決め手になる情報が、ちゃんと届く',
    d: '料金の目安、実例、店主の想い、口コミの声。知りたいことが一か所にまとまっていれば、電話・予約・来店へ、迷わず進めます。',
  },
];
---
<section id="why" class="section why">
  <div class="container">
    <p class="eyebrow">Why a website</p>
    <h2 class="h-sec" data-split>口コミの良さを、<br /><em>売上に変える</em>最後のピース。</h2>
    <div class="stats">
      <div class="stat reveal">
        <p class="num">約<span data-count="50">50</span><small>%</small></p>
        <p class="cap">小規模事業者のうち、ホームページを持っていない割合</p>
      </div>
      <div class="stat reveal">
        <p class="num"><span data-count="198000">198,000</span><small>円〜</small></p>
        <p class="cap">ホームページ＋Googleマップ整備をまとめた「集客スタートパック」</p>
      </div>
      <div class="stat reveal">
        <p class="num"><span data-count="10">10</span><small>営業日</small></p>
        <p class="cap">素材が揃ってから公開まで（撮影はこちらで伺います）</p>
      </div>
    </div>
    <p class="source">出典：中小企業白書2025ほか民間調査より（小規模企業のHP保有率は約5割）</p>
  </div>

  <div class="story" data-search-story>
    <div class="container story-grid">
      <ol class="steps">
        {steps.map((s, i) => (
          <li data-step>
            <span class="no">0{i + 1}</span>
            <h3>{s.t}</h3>
            <p>{s.d}</p>
          </li>
        ))}
      </ol>
      <div class="phone" aria-label="Google検索結果の変化のイメージ" role="img">
        <div class="screen">
          <div class="search"><span>宇都宮 割烹 個室</span></div>
          <div class="map" data-layer="0">
            <span class="pin"></span>
          </div>
          <div class="card" data-layer="0">
            <p class="shop">割烹 ささめ（サンプル）</p>
            <p class="stars">4.7 ★★★★★ <span>(88)</span></p>
            <p class="meta">割烹・会席 · 宇都宮市</p>
            <div class="chips">
              <span>経路</span><span>電話</span>
              <span class="web" data-layer="1">ウェブサイト</span>
            </div>
            <div class="photos" data-layer="1"><i></i><i></i><i></i></div>
          </div>
          <div class="site" data-layer="2">
            <p class="site-catch">季節を、ひと皿ずつ。</p>
            <ul>
              <li>おまかせ会席 ¥8,800〜</li>
              <li>ご法事・顔合わせの個室</li>
              <li>お客様の声 88件</li>
            </ul>
            <span class="book">予約する</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .why { background: var(--paper); }
  .stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 56px; }
  .stat { border-top: 1px solid var(--ink); padding-top: 20px; }
  .num { font-family: var(--font-display); font-style: italic; font-size: clamp(2.6rem, 6vw, 4.4rem); line-height: 1; color: var(--amber-deep); }
  .num small { font-family: var(--font-serif); font-style: normal; font-size: 0.35em; margin-left: 4px; color: var(--ink); }
  .cap { margin-top: 12px; font-size: 0.9rem; color: var(--ink-soft); }
  .source { margin-top: 20px; font-size: 0.72rem; color: var(--ink-muted); }

  .story { margin-top: clamp(64px, 10vw, 120px); }
  .story-grid { display: grid; grid-template-columns: 1fr 380px; gap: clamp(32px, 6vw, 96px); align-items: center; min-height: 100vh; }
  .steps { list-style: none; display: grid; gap: 28px; }
  .steps li { opacity: 0.32; transition: opacity 0.5s var(--ease-out), transform 0.5s var(--ease-out); padding-left: 20px; border-left: 2px solid var(--hairline); }
  .steps li:global(.is-active) { opacity: 1; border-left-color: var(--amber); transform: translateX(6px); }
  .no { font-family: var(--font-display); font-style: italic; color: var(--amber-deep); font-size: 1.1rem; }
  .steps h3 { font-family: var(--font-serif); font-size: clamp(1.2rem, 2.2vw, 1.6rem); margin-top: 4px; line-height: 1.5; }
  .steps p { color: var(--ink-soft); margin-top: 8px; font-size: 0.95rem; }

  .phone { width: 100%; max-width: 380px; aspect-ratio: 9 / 18.5; border-radius: 44px; background: var(--ink); padding: 12px; box-shadow: 0 50px 90px -40px rgba(21, 17, 11, 0.6); justify-self: center; }
  .screen { position: relative; height: 100%; border-radius: 34px; background: #fff; overflow: hidden; font-family: system-ui, sans-serif; letter-spacing: 0; }
  .search { margin: 44px 14px 0; border-radius: 99px; background: #f1f3f4; padding: 10px 16px; font-size: 0.8rem; color: #3c4043; }
  .map {
    height: 34%; margin-top: 12px;
    background: repeating-linear-gradient(35deg, #e8eef0 0 2px, transparent 2px 28px), repeating-linear-gradient(-55deg, #e8eef0 0 2px, transparent 2px 36px), #f6f8f6;
    position: relative;
  }
  .pin { position: absolute; left: 50%; top: 45%; width: 22px; height: 22px; background: #d93025; border-radius: 50% 50% 50% 0; transform: translate(-50%, -50%) rotate(-45deg); box-shadow: 0 4px 8px rgba(0, 0, 0, 0.3); }
  .card { padding: 16px; }
  .shop { font-size: 1.05rem; font-weight: 600; color: #202124; }
  .stars { font-size: 0.8rem; color: #e37400; margin-top: 2px; }
  .stars span, .meta { color: #70757a; }
  .meta { font-size: 0.78rem; }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 12px; }
  .chips span { font-size: 0.72rem; border: 1px solid #dadce0; border-radius: 99px; padding: 5px 12px; color: #1a73e8; }
  .photos { display: grid; grid-template-columns: repeat(3, 1fr); gap: 4px; margin-top: 12px; }
  .photos i { aspect-ratio: 1; border-radius: 6px; background: linear-gradient(135deg, #3a332b, #c29b5a); }
  .photos i:nth-child(2) { background: linear-gradient(135deg, #7b5a3a, #efe8da); }
  .photos i:nth-child(3) { background: linear-gradient(135deg, #1c1a17, #8a6d45); }
  .site { position: absolute; inset: 0; background: #161513; color: #efe8da; padding: 64px 22px 22px; display: flex; flex-direction: column; }
  .site-catch { font-family: var(--font-serif); font-size: 1.7rem; line-height: 1.4; }
  .site ul { list-style: none; margin-top: 24px; display: grid; gap: 10px; font-size: 0.85rem; }
  .site li { border-bottom: 1px solid rgba(239, 232, 218, 0.15); padding-bottom: 10px; }
  .book { margin-top: auto; text-align: center; background: #c29b5a; color: #161513; border-radius: 99px; padding: 12px; font-weight: 700; font-size: 0.9rem; }

  /* レイヤーの出し入れ */
  [data-layer='1'], [data-layer='2'] { opacity: 0; transition: opacity 0.6s var(--ease-out), transform 0.6s var(--ease-out), clip-path 0.8s var(--ease-out); }
  .web[data-layer='1'] { transform: scale(0.6); }
  .photos[data-layer='1'] { transform: translateY(12px); }
  .site[data-layer='2'] { clip-path: circle(0% at 80% 90%); opacity: 1; }
  [data-layer]:global(.is-on) { opacity: 1; transform: none; }
  .web:global(.is-on) { background: #e8f0fe; border-color: #1a73e8; font-weight: 600; }
  .site:global(.is-on) { clip-path: circle(150% at 80% 90%); }

  @media (max-width: 899px) {
    .stats { grid-template-columns: 1fr; }
    .story-grid { grid-template-columns: 1fr; min-height: 0; }
    .phone { max-width: 300px; }
  }
</style>
