---
import { site } from '../data/site';
---
<section id="contact" class="section contact">
  <div class="container grid">
    <div>
      <p class="eyebrow">お問い合わせ</p>
      <h2 class="h-sec" data-split>「うちでも必要かな」<br />くらいの段階で大丈夫です。</h2>
      <p class="lead">
        電話でもフォームでも、話しやすい方でどうぞ。ご希望があれば、お店の口コミをもとにトップページのサンプルを作ってお見せします。そこまでは費用はかかりません。
      </p>
      <dl class="direct">
        {site.tel && (
          <div><dt>お電話</dt><dd><a href={`tel:${site.tel.replace(/-/g, '')}`}>{site.tel}</a><small>{site.hours}</small></dd></div>
        )}
        <div><dt>メール</dt><dd><a href={`mailto:${site.email}`}>{site.email}</a></dd></div>
        {site.line && (
          <div><dt>LINE</dt><dd><a href={site.line} rel="noopener">LINE公式アカウント</a></dd></div>
        )}
      </dl>
    </div>

    <form class="form reveal" method="post" action="/api/contact" data-contact>
      <label>
        <span>お名前 <b>必須</b></span>
        <input name="name" required autocomplete="name" maxlength="80" />
      </label>
      <label>
        <span>屋号・店舗名</span>
        <input name="shop" autocomplete="organization" maxlength="120" />
      </label>
      <div class="row">
        <label>
          <span>メールアドレス <b>必須</b></span>
          <input name="email" type="email" required autocomplete="email" maxlength="160" />
        </label>
        <label>
          <span>電話番号</span>
          <input name="tel" type="tel" autocomplete="tel" maxlength="30" />
        </label>
      </div>
      <label>
        <span>ご相談の内容 <b>必須</b></span>
        <textarea name="message" rows="5" required maxlength="4000" placeholder="例）Googleマップの口コミはあるけれど、ホームページがありません。どのくらい費用がかかるか知りたいです。"></textarea>
      </label>
      <label class="hp" aria-hidden="true">
        <span>この欄は空のままにしてください</span>
        <input name="website" tabindex="-1" autocomplete="off" />
      </label>
      <p class="privacy">送信により<a href="/legal/privacy-policy/">プライバシーポリシー</a>に同意したものとみなします。</p>
      <button class="btn" type="submit">送信する<span class="arrow" aria-hidden="true">→</span></button>
      <p class="status" role="status" aria-live="polite"></p>
    </form>
  </div>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact]');
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const status = form.querySelector<HTMLElement>('.status')!;
    const button = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
    button.disabled = true;
    status.textContent = '送信しています…';
    status.dataset.state = '';
    try {
      const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data.error || '送信に失敗しました。');
      form.reset();
      status.dataset.state = 'ok';
      status.textContent = '送信しました。2営業日以内に、豊田からご連絡します。';
    } catch (err) {
      status.dataset.state = 'error';
      status.textContent = `${(err as Error).message} お手数ですがメールでご連絡ください。`;
    } finally {
      button.disabled = false;
    }
  });
</script>

<style>
  .contact { background: linear-gradient(180deg, var(--bg) 0%, var(--amber-pale) 140%); }
  .grid { display: grid; grid-template-columns: 1fr 1.1fr; gap: clamp(32px, 6vw, 96px); align-items: start; }
  .direct { margin-top: 40px; display: grid; gap: 18px; }
  .direct div { border-top: 1px solid var(--hairline); padding-top: 14px; }
  dt { font-size: 0.75rem; letter-spacing: 0.2em; color: var(--ink-muted); }
  dd a { font-family: var(--font-display); font-size: 1.4rem; text-decoration: none; }
  dd small { display: block; font-size: 0.8rem; color: var(--ink-muted); }
  .form { background: var(--paper); border: 1px solid var(--hairline); border-radius: 24px; padding: clamp(24px, 4vw, 44px); display: grid; gap: 18px; box-shadow: 0 40px 80px -60px rgba(21, 17, 11, 0.5); }
  .row { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
  label { display: grid; gap: 6px; font-size: 0.85rem; font-weight: 500; }
  label b { font-size: 0.68rem; background: var(--amber-deep); color: #fff; padding: 1px 6px; border-radius: 4px; margin-left: 6px; font-weight: 700; }
  input, textarea {
    width: 100%; border: 1px solid var(--hairline); border-radius: 12px; background: var(--bg);
    padding: 13px 14px; font-size: 1rem; transition: border-color 0.2s, box-shadow 0.2s;
  }
  input:focus, textarea:focus { outline: none; border-color: var(--amber); box-shadow: 0 0 0 4px color-mix(in oklab, var(--amber) 20%, transparent); }
  .hp { position: absolute; left: -9999px; }
  .privacy { font-size: 0.78rem; color: var(--ink-muted); }
  .form .btn { justify-self: start; }
  .form .btn:disabled { opacity: 0.6; cursor: wait; }
  .status { font-size: 0.9rem; min-height: 1.5em; }
  .status[data-state='ok'] { color: #2f7a4a; }
  .status[data-state='error'] { color: #b3261e; }
  @media (max-width: 860px) { .grid, .row { grid-template-columns: 1fr; } }
</style>
