---
// ロゴマーク：地図のピンの中に、昇る太陽。
interface Props { size?: number; tone?: 'forest' | 'light' }
const { size = 36, tone = 'forest' } = Astro.props;
const body = tone === 'forest' ? 'var(--forest)' : '#fff';
const hole = tone === 'forest' ? 'var(--paper)' : 'var(--forest)';
const clipId = `sun-clip-${Math.random().toString(36).slice(2, 8)}`;
---
<svg width={size} height={size * 1.2} viewBox="0 0 40 48" aria-hidden="true" class="logo-mark">
  <path d="M20 47C20 47 3 29.5 3 18.5C3 9.1 10.6 1.5 20 1.5S37 9.1 37 18.5C37 29.5 20 47 20 47Z" fill={body} />
  <circle cx="20" cy="18.5" r="10.5" fill={hole} />
  <clipPath id={clipId}><rect x="8" y="8" width="24" height="13.5" /></clipPath>
  <circle cx="20" cy="21.5" r="6.2" fill="var(--star)" clip-path={`url(#${clipId})`} />
  <rect x="11" y="21.5" width="18" height="2" rx="1" fill={body} />
</svg>
