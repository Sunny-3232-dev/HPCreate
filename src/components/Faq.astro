---
const faqs = [
  { q: 'パソコンが苦手でも頼めますか？', a: '頼めます。写真撮影も原稿も、ドメインやサーバーの手続きもこちらでやります。お願いしたいのは、お話を聞かせていただく時間だけです。' },
  { q: 'Instagramや食べログがあれば十分では？', a: 'SNSやグルメサイトは、新しい情報を届けるのに向いています。一方で、料金や実例をじっくり比べたい人には探しにくい。ホームページを土台にして、SNSやGoogleマップから案内する形をおすすめしています。' },
  { q: '月々の保守は必ず必要ですか？', a: 'いいえ、なくても大丈夫です。その場合は、ドメインとサーバーの更新方法をまとめてお渡しします。写真や営業時間を気軽に変えたい方は、保守があると楽です。' },
  { q: '宇都宮市の外でも頼めますか？', a: '栃木県内なら伺います。県外の方は、オンラインでお話しし、写真を送っていただく形で進めます。' },
  { q: '直しは何回までできますか？', a: '公開前は2回までです。回数を決めておくと、予定どおりに公開できます。公開後の小さな直しは、月々の保守の中で対応します。' },
];
---
<section id="faq" class="section faq">
  <div class="container grid">
    <div class="head">
      <p class="label">ご質問</p>
      <h2 class="h2" data-split>よく聞かれる<br />ことです。</h2>
      <p class="lead">ここにないことも、電話で気軽に聞いてください。</p>
    </div>
    <div class="list">
      {faqs.map((f) => (
        <details class="reveal" name="faq">
          <summary><span class="q" aria-hidden="true">Q</span>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq { background: var(--paper); }
  .grid { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: clamp(32px, 6vw, 88px); align-items: start; }
  .head { position: sticky; top: 110px; }
  .list { display: grid; gap: 12px; }
  details { border-radius: 16px; background: var(--stone); interpolate-size: allow-keywords; transition: background 0.3s; }
  details[open] { background: var(--star-soft); }
  summary {
    list-style: none; cursor: pointer; padding: 20px 56px 20px 20px; position: relative;
    display: flex; gap: 14px; align-items: center; font-weight: 900; font-size: 1.05rem; line-height: 1.5;
  }
  summary::-webkit-details-marker { display: none; }
  .q { flex: none; display: grid; place-items: center; width: 32px; height: 32px; border-radius: 10px; background: var(--forest); color: #fff; font-size: 0.9rem; }
  summary::after {
    content: '+'; position: absolute; right: 20px; top: 50%; translate: 0 -50%;
    font-size: 1.6rem; font-weight: 500; color: var(--forest); transition: rotate 0.35s var(--ease-out);
  }
  details[open] summary::after { rotate: 45deg; }
  details p { padding: 0 24px 22px 66px; color: var(--ink-2); }
  /* 開閉の高さアニメーション（::details-content + interpolate-size） */
  details::details-content { block-size: 0; overflow: hidden; transition: block-size 0.4s var(--ease-out), content-visibility 0.4s allow-discrete; }
  details[open]::details-content { block-size: auto; }
  @media (max-width: 860px) {
    .grid { grid-template-columns: 1fr; }
    .head { position: static; }
    details p { padding-left: 20px; }
  }
</style>
