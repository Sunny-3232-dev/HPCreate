---
const doList = [
  ['お店に伺って、写真を撮ります', '宇都宮近郊なら車で伺います。撮るのはスマホで10枚ほど。店内、仕事の様子、店主さんの顔。'],
  ['口コミを読んでから、文章を書きます', 'お客さんが書いてくれた「良かったところ」が、いちばん伝わる言葉です。原稿を用意してもらう必要はありません。'],
  ['Googleマップの登録情報も直します', '営業時間、写真、ホームページのリンク。ここが揃っているだけで、見られ方がかなり変わります。'],
];
const dontList = [
  '毎月の広告費や、成果報酬のご提案',
  '何年も解約できない契約',
  'カタカナの専門用語だらけの説明',
];
---
<section class="section approach">
  <div class="container grid">
    <div class="head">
      <p class="eyebrow">やること、やらないこと</p>
      <h2 class="h-sec" data-split>文章も写真も、<br />こちらで用意します。</h2>
    </div>
    <div>
      <ol class="do">
        {doList.map(([t, d]) => (
          <li class="reveal">
            <h3>{t}</h3>
            <p>{d}</p>
          </li>
        ))}
      </ol>
      <div class="dont reveal">
        <p class="dont-title">やらないこと</p>
        <ul>
          {dontList.map((d) => <li>{d}</li>)}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .grid { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: clamp(32px, 6vw, 96px); }
  .head { position: sticky; top: 120px; align-self: start; }
  .do { list-style: none; counter-reset: n; }
  .do li { counter-increment: n; padding: 28px 0 28px 52px; border-top: 1px solid var(--hairline); position: relative; }
  .do li::before {
    content: counter(n); position: absolute; left: 0; top: 30px;
    width: 30px; height: 30px; border-radius: 50%; background: var(--ink); color: var(--paper);
    display: grid; place-items: center; font-size: 0.85rem; font-weight: 700;
  }
  h3 { font-family: var(--font-serif); font-size: 1.25rem; line-height: 1.5; }
  .do p { color: var(--ink-soft); font-size: 0.95rem; margin-top: 8px; }
  .dont { margin-top: 24px; padding: 24px 28px; background: var(--bg-soft); border-radius: 12px; }
  .dont-title { font-weight: 700; font-size: 0.9rem; }
  .dont ul { list-style: none; margin-top: 8px; display: grid; gap: 4px; }
  .dont li { color: var(--ink-soft); font-size: 0.93rem; padding-left: 1.4em; position: relative; }
  .dont li::before { content: '×'; position: absolute; left: 0; color: var(--amber-deep); font-weight: 700; }
  @media (max-width: 860px) { .grid { grid-template-columns: 1fr; } .head { position: static; } }
</style>
