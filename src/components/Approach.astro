---
const doList = [
  { t: 'お店に伺って、写真を撮ります', d: '宇都宮近郊なら車で伺います。撮るのは10枚ほど。店内、仕事の様子、店主さんの顔。', icon: 'camera' },
  { t: '口コミを読んでから、文章を書きます', d: 'お客さんが書いてくれた「良かったところ」が、いちばん伝わる言葉です。原稿を用意していただく必要はありません。', icon: 'pen' },
  { t: 'Googleマップの情報も直します', d: '営業時間、写真、ホームページのリンク。ここが揃うだけで、見られ方がかなり変わります。', icon: 'pin' },
];
const dontList = ['毎月の広告費や、成果報酬のご提案', '何年も解約できない契約', 'カタカナの専門用語だらけの説明'];
---
<section class="section approach">
  <div class="container">
    <p class="label">やること・やらないこと</p>
    <h2 class="h2" data-split>文章も写真も、<br />こちらで用意します。</h2>
    <div class="bento">
      {doList.map((it, i) => (
        <article class:list={['cell', 'reveal', `c${i}`]}>
          <span class="icon" aria-hidden="true">
            {it.icon === 'camera' && <svg viewBox="0 0 24 24"><path d="M4 8h3l2-3h6l2 3h3v11H4z" /><circle cx="12" cy="13" r="3.5" /></svg>}
            {it.icon === 'pen' && <svg viewBox="0 0 24 24"><path d="M4 20l4-1 11-11-3-3L5 16z" /><path d="M14 7l3 3" /></svg>}
            {it.icon === 'pin' && <svg viewBox="0 0 24 24"><path d="M12 21s-7-7-7-12a7 7 0 0 1 14 0c0 5-7 12-7 12z" /><circle cx="12" cy="9" r="2.5" /></svg>}
          </span>
          <h3>{it.t}</h3>
          <p>{it.d}</p>
        </article>
      ))}
      <article class="cell dont reveal">
        <h3>やらないこと</h3>
        <ul>
          {dontList.map((d) => <li>{d}</li>)}
        </ul>
      </article>
    </div>
  </div>
</section>

<style>
  .approach { background: var(--stone); }
  .bento { display: grid; grid-template-columns: repeat(3, 1fr); grid-auto-rows: auto; gap: 16px; margin-top: 48px; }
  .cell { border-radius: var(--radius); padding: 30px 28px; background: var(--paper); }
  .c0 { grid-column: span 2; background: var(--forest); color: #fff; }
  .c0 p { color: var(--forest-ink); }
  .c2 { grid-column: span 2; }
  .icon { display: grid; place-items: center; width: 52px; height: 52px; border-radius: 14px; background: var(--star); }
  .icon svg { width: 28px; height: 28px; fill: none; stroke: var(--ink); stroke-width: 1.8; stroke-linejoin: round; stroke-linecap: round; }
  h3 { font-weight: 900; font-size: 1.3rem; line-height: 1.45; margin-top: 18px; }
  p { color: var(--ink-2); margin-top: 8px; }
  .dont { background: transparent; border: 2px dashed var(--line); }
  .dont h3 { margin-top: 0; }
  .dont ul { list-style: none; margin-top: 12px; display: grid; gap: 8px; }
  .dont li { padding-left: 1.6em; position: relative; color: var(--ink-2); }
  .dont li::before { content: '×'; position: absolute; left: 0; font-weight: 900; color: var(--alert); }
  @media (max-width: 860px) {
    .bento { grid-template-columns: 1fr; }
    .c0, .c2 { grid-column: auto; }
  }
</style>
