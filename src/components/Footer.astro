---
import { site } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="container grid">
    <div>
      <p class="brand">{site.name}</p>
      <p class="muted">{site.city}<br />地域のお店のホームページ制作と、Googleマップ集客の伴走。</p>
    </div>
    <nav aria-label="フッター">
      <a href="/#samples">提案サンプル</a>
      <a href="/#plans">料金</a>
      <a href="/#contact">お問い合わせ</a>
      <a href="/legal/specified-commercial-transaction/">特定商取引法に基づく表記</a>
      <a href="/legal/privacy-policy/">プライバシーポリシー</a>
    </nav>
  </div>
  <p class="container copy">© {year} {site.name}</p>
  <p class="giant" aria-hidden="true" data-parallax="-12">SunConnect</p>
</footer>

<style>
  .footer { background: var(--night); color: #e9e2d3; padding-top: 88px; overflow: hidden; position: relative; }
  .grid { display: grid; grid-template-columns: 1.4fr 1fr; gap: 40px; }
  .brand { font-family: var(--font-display); font-style: italic; font-size: 1.6rem; }
  .muted { color: #a9a092; font-size: 0.9rem; margin-top: 12px; }
  nav { display: grid; gap: 10px; font-size: 0.9rem; }
  nav a { text-decoration: none; color: #d7cfbf; }
  nav a:hover { color: var(--amber-light); }
  .copy { font-size: 0.78rem; color: #8a8173; margin-top: 56px; }
  .giant {
    font-family: var(--font-display); font-style: italic; font-weight: 600;
    font-size: clamp(4rem, 19vw, 17rem); line-height: 0.8; letter-spacing: -0.04em; white-space: nowrap;
    background: linear-gradient(180deg, var(--amber) 0%, transparent 85%);
    -webkit-background-clip: text; background-clip: text; color: transparent;
    margin: 32px 0 -0.12em -0.04em; opacity: 0.55; user-select: none;
  }
  @media (max-width: 720px) { .grid { grid-template-columns: 1fr; } }
</style>
