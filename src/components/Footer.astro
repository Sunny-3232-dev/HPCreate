---
import { site } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="container grid">
    <div>
      <p class="brand">{site.name}</p>
      <p class="muted">
        {site.city}<br />
        {site.tel && <>電話 <a href={`tel:${site.tel.replace(/-/g, '')}`}>{site.tel}</a>（{site.hours}）<br /></>}
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </p>
    </div>
    <nav aria-label="フッター">
      <a href="/#samples">サンプル</a>
      <a href="/#plans">料金</a>
      <a href="/#contact">お問い合わせ</a>
      <a href="/legal/specified-commercial-transaction/">特定商取引法に基づく表記</a>
      <a href="/legal/privacy-policy/">プライバシーポリシー</a>
    </nav>
  </div>
  <p class="container copy">© {year} {site.name}</p>
</footer>

<style>
  .footer { background: #1d1a16; color: #e9e2d3; padding-block: 64px 32px; }
  .grid { display: grid; grid-template-columns: 1.4fr 1fr; gap: 40px; }
  .brand { font-family: var(--font-serif); font-size: 1.4rem; font-weight: 700; }
  .muted { color: #b3aa9b; font-size: 0.9rem; margin-top: 12px; }
  .muted a { color: inherit; }
  nav { display: grid; gap: 8px; font-size: 0.9rem; }
  nav a { text-decoration: none; color: #d7cfbf; }
  nav a:hover { color: var(--amber-light); }
  .copy { font-size: 0.78rem; color: #8a8173; margin-top: 48px; }
  @media (max-width: 720px) { .grid { grid-template-columns: 1fr; } }
</style>
