---
import { site } from '../data/site';
---
<section class="hero" aria-labelledby="hero-title">
  <div class="sky" data-sky aria-hidden="true">
    <div class="fallback-sun"></div>
  </div>
  <div class="container inner">
    <p class="eyebrow">宇都宮のホームページ制作</p>
    <h1 id="hero-title" class="title" data-split="hero">口コミはいいのに、<br />ホームページがない<br />お店へ。</h1>
    <p class="dek reveal">
      Googleマップで★4以上がついているのに、検索してもホームページが出てこない。宇都宮で、そんなお店をよく見かけます。もったいないな、と思って始めた仕事です。
    </p>
    <div class="actions reveal">
      <a class="btn" href="#contact">相談してみる<span class="arrow" aria-hidden="true">→</span></a>
      {site.tel && <a class="tel" href={`tel:${site.tel.replace(/-/g, '')}`}>電話 {site.tel}</a>}
    </div>
    <p class="note reveal">制作費は税抜198,000円から。相談と、お店用のサンプル作成は無料です。</p>
  </div>
  <script>
    import { mountSun } from '../scripts/sun';
    const host = document.querySelector<HTMLElement>('[data-sky]');
    if (host) mountSun(host);
  </script>
</section>

<style>
  .hero { position: relative; min-height: 100svh; display: grid; margin-top: -72px; overflow: hidden; }
  .sky { position: absolute; inset: 0; background: linear-gradient(180deg, #faf6ec 0%, #f2ead8 100%); }
  .sky :global(canvas) { position: absolute; inset: 0; width: 100%; height: 100%; }
  .fallback-sun {
    position: absolute; right: -10%; top: 12%; width: min(60vw, 520px); aspect-ratio: 1; border-radius: 50%;
    background: radial-gradient(circle, #ffe7c7 0%, var(--amber-light) 40%, rgba(232, 146, 60, 0.35) 70%, transparent 85%);
  }
  .sky:global(.has-webgl) .fallback-sun { display: none; }
  .inner { position: relative; align-self: center; padding-top: 128px; padding-bottom: 80px; }
  .title {
    font-family: var(--font-serif); font-weight: 700;
    font-size: clamp(2.2rem, 6.2vw, 5.2rem); line-height: 1.35; letter-spacing: 0.02em;
    margin-top: 20px; word-break: auto-phrase;
  }
  .title :global(.char) { display: inline-block; will-change: transform; }
  .dek { margin-top: 28px; font-size: clamp(1rem, 1.5vw, 1.12rem); color: var(--ink-soft); max-width: 36em; text-wrap: pretty; }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 28px; margin-top: 36px; }
  .tel { font-weight: 700; font-size: 1.1rem; text-decoration: none; border-bottom: 1px solid currentColor; padding-bottom: 2px; }
  .tel:hover { color: var(--amber-deep); }
  .note { margin-top: 20px; font-size: 0.85rem; color: var(--ink-muted); }
</style>
