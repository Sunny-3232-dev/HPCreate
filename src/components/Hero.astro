---
const industries = ['工務店', '割烹・和食', '自動車整備', '写真館', '整体・接骨院', '仕出し・弁当', '造園・外構', '美容室', '葬祭', '酒販店'];
---
<section class="hero" aria-labelledby="hero-title">
  <div class="sky" data-sky aria-hidden="true">
    <div class="fallback-sun"></div>
  </div>
  <div class="container inner">
    <p class="eyebrow">Utsunomiya, Tochigi — Web Studio</p>
    <h1 id="hero-title" class="title" data-split="hero">朝陽が差すように、<br />地方の仕事に光を。</h1>
    <p class="dek reveal">
      Googleの口コミは良いのに、ホームページがない。<br class="pc" />
      そんな宇都宮のお店を、<strong>検索で「見つかる」</strong>から<strong>「選ばれる」</strong>へ。
    </p>
    <div class="actions reveal">
      <a class="btn" href="#contact" data-magnetic>無料で相談する<span class="arrow" aria-hidden="true">→</span></a>
      <a class="btn btn--ghost" href="#samples">提案サンプルを見る</a>
    </div>
  </div>
  <div class="marquee" aria-label="対応業種の例">
    <div class="track">
      {[0, 1].map((dup) => (
        <ul aria-hidden={dup === 1 ? 'true' : undefined}>
          {industries.map((i) => <li>{i}</li>)}
        </ul>
      ))}
    </div>
  </div>
  <script>
    import { mountSun } from '../scripts/sun';
    const host = document.querySelector<HTMLElement>('[data-sky]');
    if (host) mountSun(host);
  </script>
</section>

<style>
  .hero { position: relative; min-height: 100svh; display: grid; grid-template-rows: 1fr auto; margin-top: -72px; overflow: hidden; }
  .sky { position: absolute; inset: 0; background: linear-gradient(180deg, #faf6ec 0%, #f2ead8 70%, #e9dccb 100%); }
  .sky :global(canvas) { position: absolute; inset: 0; width: 100%; height: 100%; }
  .fallback-sun {
    position: absolute; right: -8%; top: 14%; width: min(64vw, 560px); aspect-ratio: 1; border-radius: 50%;
    background: radial-gradient(circle, #ffe2bc 0%, var(--amber-light) 30%, var(--amber) 55%, rgba(198, 110, 31, 0.3) 75%, transparent 90%);
    filter: blur(2px); animation: float 14s ease-in-out infinite;
  }
  .sky:global(.has-webgl) .fallback-sun { display: none; }
  @keyframes float { 50% { transform: translateY(-18px) scale(1.04); } }
  .inner { position: relative; align-self: center; padding-top: 140px; padding-bottom: 72px; }
  .title {
    font-family: var(--font-serif); font-weight: 700;
    font-size: clamp(2.3rem, 7.4vw, 6.4rem); line-height: 1.28; letter-spacing: 0.02em;
    margin-top: 28px; max-width: 12em; word-break: auto-phrase;
  }
  .title :global(.char) { display: inline-block; will-change: transform; }
  .dek { margin-top: 32px; font-size: clamp(1rem, 1.6vw, 1.2rem); color: var(--ink-soft); max-width: 34em; }
  .dek strong { color: var(--ink); background: linear-gradient(transparent 62%, var(--amber-pale) 62%); }
  .actions { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 40px; }
  .marquee { position: relative; border-block: 1px solid color-mix(in oklab, var(--ink) 12%, transparent); overflow: hidden; background: color-mix(in oklab, var(--bg) 70%, transparent); backdrop-filter: blur(6px); }
  .track { display: flex; width: max-content; animation: marquee 40s linear infinite; }
  .marquee:hover .track { animation-play-state: paused; }
  .track ul { display: flex; list-style: none; }
  .track li { font-family: var(--font-serif); font-size: 0.95rem; padding: 14px 28px; white-space: nowrap; }
  .track li::after { content: '✦'; color: var(--amber); margin-left: 56px; font-size: 0.7rem; vertical-align: middle; }
  @keyframes marquee { to { transform: translateX(-50%); } }
  @media (max-width: 720px) { .pc { display: none; } }
</style>
