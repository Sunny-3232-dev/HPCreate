---
// 架空店舗サンプルの縮小ページ（ブラウザ風フレーム）。
// view-transition-name で、一覧 → 詳細ページのあいだを同じ要素としてつなぐ。
import type { Sample } from '../data/samples';
interface Props { sample: Sample; size?: 'card' | 'hero' }
const { sample, size = 'card' } = Astro.props;
const p = sample.palette;
---
<div
  class:list={['mock', size]}
  style={`--s-bg:${p.bg};--s-ink:${p.ink};--s-accent:${p.accent};--s-soft:${p.soft};view-transition-name:mock-${sample.slug}`}
>
  <div class="chrome" aria-hidden="true"><i></i><i></i><i></i><span>{sample.slug}.example</span></div>
  <div class="page">
    <div class="nav"><b>{sample.name}</b><span>メニュー</span><span>アクセス</span><em>電話する</em></div>
    <div class="hero">
      <p class="kind">{sample.kind}・{sample.area}</p>
      <p class="catch">{sample.catch}</p>
      <p class="rate">★ {sample.rating.toFixed(1)} <small>口コミ{sample.reviews}件（例）</small></p>
    </div>
    <ul class="rows">
      {sample.services.map((s) => <li><b>{s.title}</b><span>{s.text}</span></li>)}
    </ul>
  </div>
</div>

<style>
  .mock {
    background: var(--s-bg); color: var(--s-ink); border-radius: 16px; overflow: hidden;
    box-shadow: 0 24px 50px -28px rgba(0, 0, 0, 0.55); display: flex; flex-direction: column; aspect-ratio: 4 / 5;
    font-family: var(--font);
  }
  .chrome { display: flex; align-items: center; gap: 6px; padding: 9px 14px; background: #fff; color: #555; font-size: 0.66rem; }
  .chrome i { width: 8px; height: 8px; border-radius: 50%; background: #d4d4d4; }
  .chrome span { margin-left: 8px; background: #f1f1f1; border-radius: 99px; padding: 1px 12px; }
  .page { flex: 1; display: flex; flex-direction: column; }
  .nav { display: flex; align-items: center; gap: 10px; padding: 10px 16px; font-size: 0.62rem; border-bottom: 1px solid color-mix(in oklab, var(--s-ink) 12%, transparent); }
  .nav b { font-size: 0.78rem; margin-right: auto; }
  .nav span { opacity: 0.6; }
  .nav em { font-style: normal; background: var(--s-accent); color: var(--s-bg); padding: 2px 8px; border-radius: 99px; font-weight: 700; }
  .hero { padding: 22px 16px 18px; background: var(--s-soft); flex: 1; display: flex; flex-direction: column; justify-content: flex-end; }
  .kind { font-size: 0.62rem; font-weight: 700; color: var(--s-accent); letter-spacing: 0.06em; }
  .catch { white-space: pre-line; word-break: auto-phrase; font-weight: 900; font-size: clamp(1.25rem, 2vw, 1.6rem); line-height: 1.3; margin-top: 6px; }
  .rate { margin-top: 10px; font-size: 0.8rem; font-weight: 900; color: var(--s-accent); }
  .rate small { font-weight: 500; font-size: 0.66rem; color: var(--s-ink); opacity: 0.7; }
  .rows { list-style: none; padding: 6px 16px 14px; font-size: 0.64rem; }
  .rows li { display: grid; grid-template-columns: 6.5em 1fr; gap: 8px; padding: 6px 0; border-bottom: 1px solid color-mix(in oklab, var(--s-ink) 10%, transparent); }
  .rows span { opacity: 0.7; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

  .mock.hero { aspect-ratio: auto; border-radius: 0; box-shadow: none; }
  .mock.hero .chrome { display: none; }
  .mock.hero .nav { font-size: 0.85rem; padding: 16px var(--gutter); gap: 20px; }
  .mock.hero .nav b { font-size: 1.1rem; }
  .mock.hero .hero { padding: clamp(56px, 10vw, 120px) var(--gutter); min-height: 56vh; }
  .mock.hero .kind { font-size: 0.85rem; }
  .mock.hero .catch { font-size: clamp(2.2rem, 6vw, 4.4rem); }
  .mock.hero .rate { font-size: 1.1rem; }
  .mock.hero .rate small { font-size: 0.8rem; }
  .mock.hero .rows { display: none; }
</style>
