---
// 業種ごとの線画モチーフ（SVG）。stroke は currentColor。
// pathLength=1 を使い、CSS で線を描くアニメーション（stroke-dashoffset）をかける。
import type { Sample } from '../data/samples';
interface Props { kind: Sample['motif'] }
const { kind } = Astro.props;
---
<svg viewBox="0 0 200 200" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="motif-svg">
  {kind === 'roof' && (
    <g>
      <path pathLength="1" d="M20 110 L100 40 L180 110" />
      <path pathLength="1" d="M40 95 V170 H160 V95" />
      <path pathLength="1" d="M85 170 V125 H115 V170" />
      <path pathLength="1" d="M55 115 H75 V135 H55 Z M125 115 H145 V135 H125 Z" />
      <path pathLength="1" d="M130 60 V35 H145 V73" />
    </g>
  )}
  {kind === 'wave' && (
    <g>
      <circle pathLength="1" cx="100" cy="100" r="70" />
      <path pathLength="1" d="M30 110 C50 90 70 90 90 110 S130 130 150 110 S170 90 170 100" />
      <path pathLength="1" d="M34 130 C54 110 74 110 94 130 S134 150 154 130" />
      <path pathLength="1" d="M44 90 C64 70 84 70 104 90 S144 110 164 90" />
    </g>
  )}
  {kind === 'gear' && (
    <g>
      <circle pathLength="1" cx="100" cy="100" r="44" />
      <circle pathLength="1" cx="100" cy="100" r="16" />
      <path pathLength="1" d="M100 38 V56 M100 144 V162 M38 100 H56 M144 100 H162 M56 56 L69 69 M131 131 L144 144 M144 56 L131 69 M69 131 L56 144" />
      <path pathLength="1" d="M20 180 H180" />
    </g>
  )}
  {kind === 'lens' && (
    <g>
      <rect pathLength="1" x="30" y="60" width="140" height="95" rx="12" />
      <circle pathLength="1" cx="100" cy="108" r="32" />
      <circle pathLength="1" cx="100" cy="108" r="18" />
      <path pathLength="1" d="M70 60 L80 44 H120 L130 60" />
      <circle pathLength="1" cx="150" cy="78" r="4" />
    </g>
  )}
  {kind === 'leaf' && (
    <g>
      <path pathLength="1" d="M100 170 C40 140 40 70 100 30 C160 70 160 140 100 170 Z" />
      <path pathLength="1" d="M100 170 V45" />
      <path pathLength="1" d="M100 80 L75 65 M100 105 L68 88 M100 130 L72 116 M100 80 L125 65 M100 105 L132 88 M100 130 L128 116" />
    </g>
  )}
  {kind === 'box' && (
    <g>
      <rect pathLength="1" x="35" y="70" width="130" height="90" rx="6" />
      <path pathLength="1" d="M35 115 H165 M100 70 V160" />
      <path pathLength="1" d="M28 70 H172 L160 50 H40 Z" />
      <circle pathLength="1" cx="67" cy="92" r="9" />
      <path pathLength="1" d="M115 92 H150 M115 100 H140 M50 137 H85 M115 137 H150" />
    </g>
  )}
</svg>

<style>
  .motif-svg path, .motif-svg circle, .motif-svg rect {
    stroke-dasharray: 1; stroke-dashoffset: 0;
  }
  @supports (animation-timeline: view()) {
    .motif-svg path, .motif-svg circle, .motif-svg rect {
      animation: draw linear both;
      animation-timeline: view();
      animation-range: entry 0% cover 45%;
    }
  }
  @keyframes draw { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }
</style>
