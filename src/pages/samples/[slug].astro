---
// 架空店舗の提案サンプル（1ページLPのデモ）。
import Base from '../../layouts/Base.astro';
import SampleMock from '../../components/SampleMock.astro';
import { samples, type Sample } from '../../data/samples';

export function getStaticPaths() {
  return samples.map((sample) => ({ params: { slug: sample.slug }, props: { sample } }));
}
interface Props { sample: Sample }
const { sample } = Astro.props;
const p = sample.palette;
const others = samples.filter((s) => s.slug !== sample.slug).slice(0, 3);
---
<Base title={`提案サンプル：${sample.kind}`} description={`${sample.kind}向けホームページの提案サンプル（架空の店舗）。`} noindex>
  <div class="notice">
    <div class="container">架空の店舗「{sample.name}」によるデザインサンプルです。店名・評価・口コミ文はすべて例示です。</div>
  </div>
  <div class="demo" style={`--s-bg:${p.bg};--s-ink:${p.ink};--s-accent:${p.accent};--s-soft:${p.soft}`} data-font={sample.font}>
    <SampleMock sample={sample} size="hero" />
    <section class="block container">
      <p class="lead-s reveal">{sample.lead}</p>
      <div class="services">
        {sample.services.map((s, i) => (
          <article class="svc reveal">
            <span>0{i + 1}</span>
            <h2>{s.title}</h2>
            <p>{s.text}</p>
          </article>
        ))}
      </div>
    </section>
    <section class="block voices">
      <div class="container">
        <h2 class="vh reveal">お客様の声<small>Googleの口コミより（サンプル）</small></h2>
        <div class="vgrid">
          {sample.voices.map((v) => (
            <blockquote class="reveal">
              <p>「{v.text}」</p>
              <footer>— {v.who}</footer>
            </blockquote>
          ))}
        </div>
      </div>
    </section>
  </div>

  <section class="section more">
    <div class="container">
      <p class="eyebrow">Other samples</p>
      <h2 class="h-sec">ほかの業種のサンプル</h2>
      <ul class="others">
        {others.map((s) => (
          <li><a href={`/samples/${s.slug}/`}><SampleMock sample={s} /><span>{s.kind} ↗</span></a></li>
        ))}
      </ul>
      <div class="back">
        <a class="btn" href="/#contact" data-magnetic>自分のお店のサンプルを依頼する<span class="arrow" aria-hidden="true">→</span></a>
        <a class="btn btn--ghost" href="/#samples">サンプル一覧へ戻る</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .notice { background: var(--ink); color: var(--amber-light); font-size: 0.8rem; padding: 10px 0; text-align: center; }
  .demo { background: var(--s-bg); color: var(--s-ink); }
  .demo[data-font='serif'] h2 { font-family: var(--font-serif); }
  .block { padding-block: clamp(64px, 10vw, 120px); }
  .lead-s { font-size: clamp(1.1rem, 2vw, 1.45rem); max-width: 30em; line-height: 2; }
  .services { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 56px; }
  .svc { border-top: 2px solid var(--s-accent); padding-top: 20px; }
  .svc span { color: var(--s-accent); font-family: var(--font-display); font-style: italic; font-size: 1.4rem; }
  .svc h2 { font-size: 1.3rem; margin-top: 6px; }
  .svc p { opacity: 0.8; margin-top: 8px; font-size: 0.93rem; }
  .voices { background: var(--s-soft); }
  .vh { font-size: 1.6rem; }
  .vh small { display: block; font-size: 0.75rem; opacity: 0.6; font-weight: 400; font-family: var(--font-body); }
  .vgrid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; margin-top: 32px; }
  blockquote { background: var(--s-bg); padding: 28px; border-radius: 16px; font-size: 1.05rem; }
  blockquote footer { margin-top: 12px; font-size: 0.82rem; opacity: 0.65; }
  .others { list-style: none; display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 40px; }
  .others a { text-decoration: none; display: grid; gap: 12px; font-size: 0.88rem; }
  .back { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 56px; }
  @media (max-width: 860px) { .services, .vgrid, .others { grid-template-columns: 1fr; } }
</style>
